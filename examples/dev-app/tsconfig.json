{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "spatialboard": ["../../src/index.ts"],
      "spatialboard/*": ["../../src/*"],
      "@spatialboard-exemplars": ["../../../llm-guidance/spatialboard-exemplars/loaders/index.ts"],
      "@spatialboard-exemplars/*": ["../../../llm-guidance/spatialboard-exemplars/loaders/*"]
    }
  },
  "include": ["src", "../../../llm-guidance/spatialboard-exemplars/loaders/**/*.ts"]
}
