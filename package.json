{
  "name": "spatialboard",
  "version": "0.2.0",
  "description": "A React + TypeScript spatial canvas and node-board library for whiteboards, visual editors, and graph interfaces.",
  "license": "MIT",
  "author": "Hisham Khalifa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hishamk/spatialboard.git"
  },
  "homepage": "https://github.com/hishamk/spatialboard#readme",
  "bugs": {
    "url": "https://github.com/hishamk/spatialboard/issues"
  },
  "keywords": [
    "canvas",
    "whiteboard",
    "diagram",
    "graph",
    "mermaid",
    "sequence-diagram",
    "react",
    "typescript",
    "node-editor",
    "visual-editor"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blocknote": {
      "types": "./dist/blocknote.d.ts",
      "import": "./dist/blocknote.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=examples/basic",
    "dev:rich-text": "npm run dev --workspace=examples/rich-text",
    "dev:custom": "npm run dev --workspace=examples/custom-nodes",
    "dev:app": "npm run dev --workspace=examples/dev-app",
    "dev:video": "npm run dev --workspace=examples/video-notes",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "node -e \"try{require.resolve('vite')}catch{console.log('spatialboard: vite unavailable — skipping prepare build (using provided dist)');process.exit(0)}require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "preview": "npm run preview --workspace=examples/dev-app",
    "test": "vitest run",
    "verify:headless": "npm run build && node scripts/assert-headless.mjs",
    "verify:consumer": "bash scripts/consumer-smoke.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@blocknote/core": "^0.46",
    "@blocknote/mantine": "^0.46",
    "@blocknote/react": "^0.46",
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@blocknote/core": {
      "optional": true
    },
    "@blocknote/mantine": {
      "optional": true
    },
    "@blocknote/react": {
      "optional": true
    },
    "@mantine/core": {
      "optional": true
    },
    "@mantine/hooks": {
      "optional": true
    }
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "nanoid": "^5",
    "perfect-freehand": "^1.2",
    "roughjs": "^4.6"
  },
  "devDependencies": {
    "@blocknote/core": "^0.46",
    "@blocknote/mantine": "^0.46",
    "@blocknote/react": "^0.46",
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "examples/*"
  ]
}
