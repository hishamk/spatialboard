{
  "name": "spatialboard",
  "version": "0.2.0",
  "description": "A React + TypeScript spatial canvas and node-board library for whiteboards, visual editors, and graph interfaces.",
  "license": "MIT",
  "author": "Hisham Khalifa",
  "repository": {
    "type": "git",
    "url": "https://github.com/hishamk/spatialboard.git"
  },
  "homepage": "https://github.com/hishamk/spatialboard#readme",
  "bugs": {
    "url": "https://github.com/hishamk/spatialboard/issues"
  },
  "keywords": [
    "canvas",
    "whiteboard",
    "diagram",
    "graph",
    "mermaid",
    "sequence-diagram",
    "react",
    "typescript",
    "node-editor",
    "visual-editor"
  ],
  "type": "module",
  "main": "./dist/spatialboard.js",
  "module": "./dist/spatialboard.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/spatialboard.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=examples/dev-app",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "npm run preview --workspace=examples/dev-app",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@blocknote/core": "^0.46",
    "@blocknote/mantine": "^0.46",
    "@blocknote/react": "^0.46",
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "react": "^18",
    "react-dom": "^18"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "nanoid": "^5",
    "perfect-freehand": "^1.2",
    "roughjs": "^4.6"
  },
  "devDependencies": {
    "@blocknote/core": "^0.46",
    "@blocknote/mantine": "^0.46",
    "@blocknote/react": "^0.46",
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "assemblyscript": "^0.28.10",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "examples/*"
  ]
}