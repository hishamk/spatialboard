{
  "name": "spatialboard",
  "version": "0.1.0",
  "description": "A React + TypeScript spatial canvas and node-board library for whiteboards, visual editors, and graph interfaces.",
  "license": "MIT",
  "author": "Hisham Khalifa",
  "repository": {
    "type": "git",
    "url": "https://github.com/hishamk/spatialboard.git",
    "directory": "spatialboard"
  },
  "homepage": "https://github.com/hishamk/spatialboard",
  "bugs": {
    "url": "https://github.com/hishamk/spatialboard/issues"
  },
  "keywords": [
    "canvas",
    "whiteboard",
    "diagram",
    "graph",
    "react",
    "typescript",
    "node-editor",
    "visual-editor"
  ],
  "type": "module",
  "main": "./dist/spatialboard.js",
  "module": "./dist/spatialboard.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/spatialboard.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=examples/dev-app",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "npm run preview --workspace=examples/dev-app"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@blocknote/core": "^0.46",
    "@blocknote/mantine": "^0.46",
    "@blocknote/react": "^0.46",
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "react": "^18",
    "react-dom": "^18"
  },
  "dependencies": {
    "nanoid": "^5",
    "perfect-freehand": "^1.2",
    "roughjs": "^4.6"
  },
  "devDependencies": {
    "@blocknote/core": "^0.46",
    "@blocknote/mantine": "^0.46",
    "@blocknote/react": "^0.46",
    "@imgly/background-removal": "^1.7.0",
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^5",
    "vite": "^5"
  },
  "workspaces": [
    "examples/*"
  ]
}
